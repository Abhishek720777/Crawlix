# Environment variables template for production deployment
PROJECT_NAME=Crawlix
ENVIRONMENT=production
SECRET_KEY=change_this_to_a_strong_random_secret_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Settings
POSTGRES_USER=crawlix_user
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=crawlix_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://crawlix_user:your_secure_postgres_password@postgres:5432/crawlix_db
DATABASE_URL_SYNC=postgresql://crawlix_user:your_secure_postgres_password@postgres:5432/crawlix_db

# Redis & Celery Settings
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
